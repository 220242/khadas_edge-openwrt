diff --git a/net/zerotier/Config.in b/net/zerotier/Config.in
index e08ec75..7b7ab50 100644
--- a/net/zerotier/Config.in
+++ b/net/zerotier/Config.in
@@ -11,4 +11,13 @@ config ZEROTIER_ENABLE_SELFTEST
 	depends on PACKAGE_zerotier
 	default n
 
+config ZEROTIER_ENABLE_CONTROLLER
+	bool "Build with the network controller (ZeroTier Source-Available License)"
+	depends on PACKAGE_zerotier
+	default n
+	help
+	  Adds the ZeroTier network controller (nonfree/ directory of the
+	  ZeroTier sources). It is licensed for non-commercial use only,
+	  do not distribute firmware images built with this option.
+
 endmenu
diff --git a/net/zerotier/Makefile b/net/zerotier/Makefile
index ffbab16..4f4e6b6 100644
--- a/net/zerotier/Makefile
+++ b/net/zerotier/Makefile
@@ -21,6 +21,7 @@ PKG_LICENSE_FILES:=LICENSE.txt
 PKG_ASLR_PIE:=0
 PKG_BUILD_PARALLEL:=1
 PKG_BUILD_FLAGS:=gc-sections
+PKG_CONFIG_DEPENDS:=CONFIG_ZEROTIER_ENABLE_CONTROLLER
 
 include $(INCLUDE_DIR)/package.mk
 
@@ -45,6 +46,10 @@ ifeq ($(CONFIG_ZEROTIER_ENABLE_DEBUG),y)
 MAKE_FLAGS += ZT_DEBUG=1
 endif
 
+ifeq ($(CONFIG_ZEROTIER_ENABLE_CONTROLLER),y)
+MAKE_FLAGS += ZT_NONFREE=1
+endif
+
 MAKE_FLAGS += \
 	ZT_EMBEDDED=1 \
 	ZT_SSO_SUPPORTED=0 \
