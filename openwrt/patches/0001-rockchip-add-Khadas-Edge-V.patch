diff --git a/package/boot/uboot-rockchip/patches/301-khadas-edge-v-enable-HDMI.patch b/package/boot/uboot-rockchip/patches/301-khadas-edge-v-enable-HDMI.patch
new file mode 100644
index 0000000..b6acaee
--- /dev/null
+++ b/package/boot/uboot-rockchip/patches/301-khadas-edge-v-enable-HDMI.patch
@@ -0,0 +1,19 @@
+From: khadas_edge-openwrt
+Subject: [PATCH] rockchip: khadas-edge-v: enable HDMI output
+
+The boot loader shows up on HDMI (stdout=serial,vidconsole is set by
+evb_rk3399.h), like on the other RK3399 boards with HDMI.
+
+diff --git a/configs/khadas-edge-v-rk3399_defconfig b/configs/khadas-edge-v-rk3399_defconfig
+index 3903c4e2..fd5df49e 100644
+--- a/configs/khadas-edge-v-rk3399_defconfig
++++ b/configs/khadas-edge-v-rk3399_defconfig
+@@ -85,4 +85,8 @@ CONFIG_USB_ETHER_SMSC95XX=y
+ CONFIG_USB_GADGET=y
+ CONFIG_USB_GADGET_DOWNLOAD=y
+ CONFIG_USB_FUNCTION_ROCKUSB=y
++CONFIG_VIDEO=y
++CONFIG_DISPLAY=y
++CONFIG_VIDEO_ROCKCHIP=y
++CONFIG_DISPLAY_ROCKCHIP_HDMI=y
+ CONFIG_ERRNO_STR=y
diff --git a/target/linux/rockchip/armv8/base-files/etc/board.d/02_network b/target/linux/rockchip/armv8/base-files/etc/board.d/02_network
index ea4a2cc..d295a5b 100644
--- a/target/linux/rockchip/armv8/base-files/etc/board.d/02_network
+++ b/target/linux/rockchip/armv8/base-files/etc/board.d/02_network
@@ -91,6 +91,10 @@ rockchip_setup_macs()
 		wan_mac=$(macaddr_generate_from_mmc_cid mmcblk1)
 		lan_mac=$(macaddr_add "$wan_mac" 1)
 		;;
+	khadas,edge-v)
+		# eMMC (mmc2) CID: stable, unlike the SD card
+		lan_mac=$(macaddr_generate_from_mmc_cid mmcblk2)
+		;;
 	friendlyarm,nanopi-r3s|\
 	friendlyarm,nanopi-r5c|\
 	friendlyarm,nanopi-r6c|\
