#!/bin/sh /etc/rc.common
# KVM / QEMU virtual machines, config: /etc/config/kvm

START=99
STOP=01
USE_PROCD=1

QEMU=/usr/bin/qemu-system-aarch64
QEMU_IMG=/usr/bin/qemu-img
FW_CODE=/usr/share/qemu/edk2-aarch64-code.fd
FW_VARS=/usr/share/qemu/edk2-arm-vars.fd
RUN_DIR=/var/run/kvm

log() {
	logger -t kvm "$*"
}

# tap device name: max 15 chars
vm_tap() {
	printf 'vm-%.12s' "$1"
}

vm_mac() {
	# stable locally administered MAC from VM name
	local h="$(echo -n "$1" | md5sum)"
	printf '52:54:%s:%s:%s:%s' \
		"$(echo $h | cut -c1-2)" "$(echo $h | cut -c3-4)" \
		"$(echo $h | cut -c5-6)" "$(echo $h | cut -c7-8)"
}

start_vm() {
	local name="$1"
	local enabled cpus memory disk disk_size cdrom bridge mac vnc cpu_affinity respawn extra
	local storage format tap vars

	config_get_bool enabled "$name" enabled 0
	[ "$enabled" = 1 ] || return 0

	config_get storage global storage /mnt/vm
	config_get cpus "$name" cpus 1
	config_get memory "$name" memory 512
	config_get disk "$name" disk "$storage/$name.qcow2"
	config_get disk_size "$name" disk_size
	config_get cdrom "$name" cdrom
	config_get bridge "$name" bridge br-lan
	config_get mac "$name" mac
	config_get vnc "$name" vnc
	config_get cpu_affinity "$name" cpu_affinity
	config_get_bool respawn "$name" respawn 0
	config_get extra "$name" extra

	[ -x "$QEMU" ] || { log "$name: $QEMU not installed"; return 1; }
	[ -c /dev/kvm ] || { log "$name: /dev/kvm not found, kernel without KVM"; return 1; }
	[ -f "$FW_CODE" ] || { log "$name: UEFI firmware $FW_CODE not found"; return 1; }

	mkdir -p "$storage" "$RUN_DIR" || return 1

	if [ ! -e "$disk" ]; then
		[ -n "$disk_size" ] || { log "$name: disk $disk not found"; return 1; }
		log "$name: create disk $disk $disk_size"
		"$QEMU_IMG" create -f qcow2 "$disk" "$disk_size" >/dev/null || return 1
	fi

	case "$disk" in
		*.qcow2) format=qcow2 ;;
		*) format=raw ;;
	esac

	# per VM UEFI variables store
	vars="$storage/$name.vars.fd"
	[ -f "$vars" ] || cp "$FW_VARS" "$vars" || return 1

	# network: tap device in bridge
	tap="$(vm_tap "$name")"
	[ -n "$mac" ] || mac="$(vm_mac "$name")"
	if [ -n "$bridge" ]; then
		ip link show "$tap" >/dev/null 2>&1 || \
			ip tuntap add dev "$tap" mode tap || return 1
		ip link set "$tap" master "$bridge" up || return 1
	fi

	procd_open_instance "$name"

	[ -n "$cpu_affinity" ] && procd_append_param command /usr/bin/taskset -c "$cpu_affinity"

	procd_append_param command "$QEMU" \
		-name "$name" \
		-nodefaults -no-user-config \
		-machine virt,gic-version=host -accel kvm \
		-cpu host -smp "$cpus" -m "$memory" \
		-drive if=pflash,format=raw,readonly=on,file="$FW_CODE" \
		-drive if=pflash,format=raw,file="$vars" \
		-drive if=none,id=hd0,format="$format",file="$disk" \
		-device virtio-blk-pci,drive=hd0,bootindex=1 \
		-device qemu-xhci -device usb-kbd -device usb-tablet \
		-device virtio-rng-pci \
		-serial unix:"$RUN_DIR/$name.serial",server=on,wait=off \
		-monitor unix:"$RUN_DIR/$name.monitor",server=on,wait=off

	if [ -n "$cdrom" ]; then
		procd_append_param command \
			-device virtio-scsi-pci,id=scsi0 \
			-drive if=none,id=cd0,media=cdrom,readonly=on,file="$cdrom" \
			-device scsi-cd,drive=cd0,bus=scsi0.0,bootindex=0
	fi

	if [ -n "$bridge" ]; then
		procd_append_param command \
			-netdev tap,id=net0,ifname="$tap",script=no,downscript=no,vhost=on \
			-device virtio-net-pci,netdev=net0,mac="$mac"
	fi

	if [ -n "$vnc" ]; then
		procd_append_param command -device virtio-gpu-pci -vnc ":$vnc"
	else
		procd_append_param command -display none
	fi

	[ -n "$extra" ] && procd_append_param command $extra

	[ "$respawn" = 1 ] && procd_set_param respawn 3600 10 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 30
	procd_close_instance

	log "$name: started (cpus=$cpus memory=${memory}M${vnc:+ vnc=:$vnc})"
}

start_service() {
	config_load kvm
	config_foreach start_vm vm
}

service_triggers() {
	procd_add_reload_trigger kvm
}
