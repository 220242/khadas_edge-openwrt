# Kernel options this build adds to the OpenWrt rockchip/armv8 kernel for Edge-V

# openwrt/patches/0002-rockchip-armv8-USB-UAS-built-in.patch:
# root file system on a USB SSD (UAS) - USB storage, SCSI disk and NVMe are
# already built in by OpenWrt
CONFIG_USB_UAS=y

# openwrt/feed/khadas-edge-display (kmod-drm-rockchip): HDMI console
CONFIG_DRM_ROCKCHIP=m
CONFIG_ROCKCHIP_VOP=y
# CONFIG_ROCKCHIP_VOP2 is not set
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_DRM_DW_HDMI=m
# CONFIG_DRM_DW_HDMI_CEC is not set
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_FRAMEBUFFER_CONSOLE=y
